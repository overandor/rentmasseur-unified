{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/engine/:path*", "destination": "https://josephrw-rentmasseur-optimizer.hf.space/api/:path*" },
    { "source": "/os/:path*", "destination": "https://josephrw-rentmasseur-optimizer.hf.space/api/os/:path*" }
  ]
}
