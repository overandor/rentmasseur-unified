FROM python:3.11-slim

WORKDIR /app

# Install system deps for Selenium/Chrome
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget gnupg ca-certificates fonts-liberation libnss3 libxss1 \
    libappindicator3-1 libasound2 libatk-bridge2.0-0 libgtk-3-0 \
    libgbm1 libdrm2 libxcomposite1 libxdamage1 libxrandr2 xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Chrome
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list \
    && apt-get update && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir selenium

# Copy all subsystem code
COPY server.py daemon.py daily_promotion.py app.py ./
COPY rm_revenue_engine/ rm_revenue_engine/
COPY rm_pri/ rm_pri/
COPY rm_traffic/ rm_traffic/
COPY content/ content/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
EXPOSE 7860

CMD ["python", "daemon.py"]
