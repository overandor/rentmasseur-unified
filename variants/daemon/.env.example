# RentMasseur Optimizer environment variables

# RentMasseur account credentials (required for traffic engine)
RM_USERNAME=your_username
RM_PASSWORD=your_password

# Admin token for mutation endpoints in server.py
ADMIN_TOKEN=change_me_to_a_long_random_string

# Space / repo identifiers
SPACE_NAME=rentmasseur-optimizer
HF_SPACE=rentmasseur-optimizer

# GitHub integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=overandor/membra-companyos

# Daemon timing
DAEMON_INTERVAL=60
TRAFFIC_CYCLE_MINUTES=5
DAILY_PROMOTION_HOUR=6
BACKFILL_VIEWS_DAILY=0
