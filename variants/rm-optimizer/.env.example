# RentMasseur automation credentials (used by optimizer / availability keeper)
RENTMASSEUR_USERNAME=your_username
RENTMASSEUR_PASSWORD=your_password

# Required to start the public Hugging Face browser-job endpoint. Configure the
# same value in the private control plane; never commit the real token.
VISIT_AGENT_TOKEN=replace_with_a_long_random_value

# Groq API key for bio generation and intent routing
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Clickable booking link used in bios and CTAs
REBRANDLY_LINK=https://rebrand.ly/carpathianwolf

# Hugging Face Space for deployment
HF_SPACE_NAME=josephrw/rentmasseur-optimizer
